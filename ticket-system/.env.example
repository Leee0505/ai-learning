# ===========================================
# Ticket Management System — Environment Config
# ===========================================
# Copy this file to .env and adjust for your environment
# Phase 1: MySQL, Redis, JWT (Kafka/ES are future phases)

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=ticket_db
MYSQL_USER=ticket_user
MYSQL_PASSWORD=ticket_pass

# Redis (dev: no password)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-to-a-random-256-bit-key-in-production
# Access token: 2 hours = 7200000 ms
# Refresh token: 7 days = 604800000 ms

# --- Future Phases (commented out) ---
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# ELASTICSEARCH_HOST=localhost:9200
# FILE_STORAGE_PATH=./uploads
# MINIO_ENDPOINT=http://localhost:9000
